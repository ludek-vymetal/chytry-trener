rules_version = '2';

// Pravidla pro Cloud Firestore – aplikace Chytrý trenér.
// Vlož celé do Firebase konzole: Firestore Database → Pravidla (Rules) → Publikovat.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ---------------------------------------------------------------
    // Záloha trenéra (a vlastní záloha klienta) – jen vlastník účtu.
    // ---------------------------------------------------------------
    match /coaches/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // Online coaching: propojení trenér ↔ klient.
    // Dokument coaching/{linkId} a vše pod ním vidí jen trenér a klient.
    // ---------------------------------------------------------------
    match /coaching/{linkId} {
      // resource == null: dotaz na propojení, které ještě neexistuje.
      allow read: if signedIn() && (
        resource == null ||
        resource.data.coachUid == request.auth.uid ||
        resource.data.clientUid == request.auth.uid
      );

      // Propojení zakládá jen trenér (ne anonymní účet).
      allow create: if signedIn() && !isAnonymous()
        && request.resource.data.coachUid == request.auth.uid;

      // Trenér může měnit cokoli; klient se jen jednou připojí kódem.
      allow update: if signedIn() && (
        resource.data.coachUid == request.auth.uid ||
        (
          resource.data.clientUid == null &&
          request.resource.data.clientUid == request.auth.uid &&
          request.resource.data.joinCode == resource.data.inviteCode &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clientUid', 'joinedAt', 'joinCode'])
        )
      );

      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;

      // Sdílená data klienta (plány, jídlo, tréninky, profil…).
      match /{document=**} {
        allow read, write: if signedIn() && (
          get(/databases/$(database)/documents/coaching/$(linkId)).data.coachUid == request.auth.uid ||
          get(/databases/$(database)/documents/coaching/$(linkId)).data.clientUid == request.auth.uid
        );
      }
    }

    // ---------------------------------------------------------------
    // Online rezervace termínů.
    // booking/{coachUid}            – nastavení a obsazené časy (bez jmen)
    // booking/{coachUid}/slots/*    – zámky 15min úseků (proti dvojí rezervaci)
    // booking/{coachUid}/requests/* – rezervace klientů
    // ---------------------------------------------------------------
    match /booking/{coachUid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == coachUid;

      // Klient propojený s tímto trenérem (podle coaching/{linkId}).
      function isLinkedClient(linkId) {
        let link = get(/databases/$(database)/documents/coaching/$(linkId)).data;
        return link.coachUid == coachUid && link.clientUid == request.auth.uid;
      }

      match /slots/{slotId} {
        allow read: if signedIn();
        // Jen založení – obsazený úsek nejde přepsat (druhý klient dostane chybu).
        allow create: if signedIn() && (
          request.auth.uid == coachUid ||
          (
            request.resource.data.clientUid == request.auth.uid &&
            isLinkedClient(request.resource.data.linkId)
          )
        );
        allow update: if signedIn() && request.auth.uid == coachUid;
        allow delete: if signedIn() && (
          request.auth.uid == coachUid ||
          resource.data.clientUid == request.auth.uid
        );
      }

      match /requests/{requestId} {
        allow read: if signedIn() && (
          request.auth.uid == coachUid ||
          resource.data.clientUid == request.auth.uid
        );
        allow create: if signedIn()
          && request.resource.data.clientUid == request.auth.uid
          && request.resource.data.coachUid == coachUid
          && request.resource.data.status == 'booked'
          && isLinkedClient(request.resource.data.linkId);
        // Trenér cokoli; klient jen zrušit svou rezervaci.
        allow update: if signedIn() && (
          request.auth.uid == coachUid ||
          (
            resource.data.clientUid == request.auth.uid &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt'])
          )
        );
        allow delete: if signedIn() && request.auth.uid == coachUid;
      }
    }

    // ---------------------------------------------------------------
    // Pozvánky – kód zná jen trenér a klient, kterému ho poslal.
    // ---------------------------------------------------------------
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && !isAnonymous()
        && request.resource.data.coachUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.coachUid == request.auth.uid ||
        (
          resource.data.usedBy == null &&
          request.resource.data.usedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usedBy', 'usedAt'])
        )
      );
    }

    // ---------------------------------------------------------------
    // Aktivační kódy předplatného.
    // Kódy zatím zakládej ručně v konzoli (create je z aplikace zakázán).
    // ---------------------------------------------------------------
    match /license_codes/{code} {
      allow get: if signedIn();
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedBy', 'usedAt']);
    }
  }
}
